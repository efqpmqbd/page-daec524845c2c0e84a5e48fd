padding:4px 0 4px 22px;color:var(--paper);font-size:17px;line-height:1.7}\n.pull b{color:var(--green);font-weight:700}\n\n/* 区块通用 */\nsection{padding:76px 0;border-bottom:1px solid var(--line)}\n.sec-head{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:baseline;margin-bottom:44px}\n.sec-num{font-size:13px;letter-spacing:.24em;color:var(--green);border:1px solid rgba(198,255,46,.4);padding:3px 10px}\nh2{font-size:clamp(24px,3.4vw,34px);line-height:1.25;margin:0;font-weight:800;letter-spacing:-.005em}\n.sec-sub{color:var(--muted);font-size:14px;margin:0;flex-basis:100%}\n\n/* 使用说明：编号大字压底 + 左色条 */\n.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}\n.step{position:relative;background:var(--ink-2);border-left:3px solid var(--green);padding:28px 26px 74px;overflow:hidden}\n.step h3{margin:0 0 12px;font-size:19px;letter-spacing:.01em;color:var(--paper)}\n.step p{margin:0;color:#b9b9b2;font-size:15px}\n.step p + p{margin-top:10px}\n.step .bignum{position:absolute;right:8px;bottom:-18px;font-size:96px;line-height:1;font-weight:800;color:#1e1e1e;letter-spacing:-.04em;user-select:none}\n\n/* 套餐对比表 */\n.table-wrap{overflow-x:auto;border:1px solid var(--line)}\ntable{border-collapse:collapse;width:100%;min-width:720px;font-size:15px}\ncaption{caption-side:top;text-align:left;padding:18px 20px;color:var(--muted);font-size:13px;letter-spacing:.06em;border-bottom:1px solid var(--line);background:#000}\nth,td{padding:16px 20px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}\nthead th{background:#000;color:var(--paper);font-size:14px;letter-spacing:.08em;border-bottom:1px solid #333}\nthead th .tag{display:block;margin-top:6px;font-size:11px;letter-spacing:.16em;color:var(--ink);background:var(--green);padding:1px 8px;width:fit-content}\ntbody th{font-weight:600;color:#b9b9b2;width:200px;background:var(--ink-2);font-size:14px}\ntbody td{color:var(--paper)}\ntbody tr:last-child th,tbody tr:last-child td{border-bottom:none}\n.price{font-size:22px;font-weight:800;color:var(--green);display:block;line-height:1.3}\n.price small{display:block;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:.04em;margin-top:4px}\n.col-featured{background:rgba(198,255,46,.05)}\n.yes{color:var(--green)}\n.no{color:#5a5a54}\n.note{margin-top:18px;font-size:13px;color:var(--muted);max-width:62em}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:26px}\n.client{position:relative;background:var(--ink-2);padding:26px 26px 70px;border-top:3px solid var(--green)}\n.client h3{margin:0 0 10px;font-size:18px}\n.client p{margin:0 0 10px;color:#b9b9b2;font-size:15px}\n.client .bignum{position:absolute;right:10px;bottom:-16px;font-size:82px;line-height:1;font-weight:800;color:#1e1e1e;letter-spacing:-.04em;user-select:none}\n.client p.meta{font-size:13px;color:var(--muted);margin:0}\n\n/* FAQ 双栏问答 */\n.faq{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px 40px}\n.qa{border-top:1px solid var(--line);padding-top:20px}\n.qa h3{margin:0 0 10px;font-size:17px;line-height:1.5;color:var(--paper);font-weight:700}\n.qa h3::before{content:\"问\";display:inline-block;margin-right:9px;font-size:11px;letter-spacing:.1em;color:var(--ink);background:var(--green);padding:1px 6px;vertical-align:2px}\n.qa p{margin:0;color:#b9b9b2;font-size:15px}\n.qa p + p{margin-top:10px}\n\n/* 结尾 */\nfooter{padding:54px 0 70px;color:var(--muted);font-size:13px}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:12px 30px;align-items:baseline}\nfooter strong{color:var(--paper);font-size:15px;letter-spacing:.02em}\nfooter a{color:var(--muted);border:none}\nfooter a:hover{color:var(--green)}\n\n@media (max-width:860px){\n  .lede{grid-template-columns:1fr}\n  .steps{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  .faq{grid-template-columns:1fr}\n  .toc{margin-left:0}\n  section{padding:56px 0}\n  .masthead{padding:48px 0 52px}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumb\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a><span class=\"sep\">/</span>\n      <a href=\"#plans\">订阅方案</a><span class=\"sep\">/</span>\n      <span class=\"here\">使用说明与常见问题</span>\n    </nav>\n    <nav class=\"toc\" aria-label=\"本页目录\">\n      <a href=\"#how\"><span>01</span>怎么用</a>\n      <a href=\"#plans\"><span>02</span>套餐怎么选</a>\n      <a href=\"#clients\"><span>03</span>客户端</a>\n      <a href=\"#faq\"><span>04</span>常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"masthead\">\n    <div class=\"wrap\">\n      <span class=\"kicker\">花栗鼠 · 使用说明</span>\n      <h1>花栗鼠不是<em>一个按钮</em>，<br>它是一段你需要读两遍的说明。</h1>\n\n      <div class=\"lede\">\n        <div>\n          <p class=\"first\">很多人第一次打开花栗鼠，期待的是一个巨大的开关：按下去，一切都通了。实际上，真正决定体验好坏的东西不在开关上，而在开关之前的三个决定——你选哪一档、你用什么设备、你把它放在什么习惯里。</p>\n          <p>所以我们把这一页写成了一篇说明文，而不是一张宣传海报。它分成四段：先讲使用方法，再讲套餐之间的差别，然后讲客户端，最后把反复被问到的问题归在一起。你可以从头读到尾，也可以只跳到自己卡住的那一段。</p>\n          <p>如果你只想拿走一句话：<b>先确定自己的用量和设备数量，再挑套餐；先固定一台主力设备，再谈其他。</b>其余内容都是对这句话的解释。</p>\n        </div>\n        <aside class=\"pull\">\n          我们尽量不写“极速”“秒开”这类词，因为这类词对选择没有帮助。你能在这页上读到的，是每一档之间的实际分界：多少流量、几台设备、多快的响应路径，以及当这些事情发生变化时，你应该去看哪里。\n          <br><br>\n          —— 花栗鼠编辑组\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01</span>\n        <h2>先从三步开始，别急着调参数</h2>\n        <p class=\"sec-sub\">顺序比技巧重要。绝大多数“用不起来”，其实停在了第一步。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <h3>第一步：算清你一个月大概用多少</h3>\n          <p>打开你目前设备的流量统计，看一眼最近 30 天。视频、下载、云盘同步是三个消耗大户，其余网页与通讯的占比通常很小。</p>\n          <p>把结果往上一档取，而不是往下取。流量这件事，留余量比省钱更省心。</p>\n          <span class=\"bignum\">01</span>\n        </article>\n\n        <article class=\"step\">\n          <h3>第二步：数一数同时在线的是几台</h3>\n          <p>“同时在线”指同一时刻正在联网的设备，而不是你拥有几台设备。手机加电脑是最常见的组合，平板和电视盒往往是被忽略的第三、第四台。</p>\n          <p>数完再回头看一眼套餐档位，这一步能替你省掉之后所有的追问。</p>\n          <span class=\"bignum\">02</span>\n        </article>\n\n        <article class=\"step\">\n          <h3>第三步：把主力设备定下来</h3>\n          <p>选一台你每天最常使用的设备先跑通，确认日常操作顺畅，再去配置第二台。同时在多台上排查问题，只会让问题看起来更复杂。</p>\n          <p>主力设备跑顺之后，其余设备基本是同一套流程的重复。</p>\n          <span class=\"bignum\">03</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02</span>\n        <h2>三档套餐放在同一张表里看</h2>\n        <p class=\"sec-sub\">横向对比比纵向罗列更容易做决定，因为差别都在同一行上。</p>\n      </div>\n\n      <div class=\"table-wrap\">\n        <table>\n          以下为花栗鼠当前展示的三档订阅方案，价格以月付标示，年付价并列说明。\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版<span class=\"tag\">入门</span></th>\n              <th class=\"col-featured\">旗舰版<span class=\"tag\">多数人的选择</span></th>\n              <th>团队版<span class=\"tag\">多人协作</span></th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <th>月付价格</th>\n              <td><span class=\"price\">¥15<small>每月</small></span></td>\n              <td class=\"col-featured\"><span class=\"price\">¥35<small>每月</small></span></td>\n              <td><span class=\"price\">¥85<small>每月</small></span></td>\n            </tr>\n            <tr>\n              <th>年付价格</th>\n              <td>¥150 / 年</td>\n              <td class=\"col-featured\">¥350 / 年</td>\n              <td>¥850 / 年</td>\n            </tr>\n            <tr>\n              <th>每月流量额度</th>\n              <td>100GB</td>\n              <td class=\"col-featured\">300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <th>同时在线设备</th>\n              <td>3 台</td>\n              <td class=\"col-featured\">5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <th>流媒体解锁</th>\n              <td>基础流媒体</td>\n              <td class=\"col-featured\">全节点原生流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n            </tr>\n            <tr>\n              <th>线路与优化</th>\n              <td>普通线路节点池</td>\n              <td class=\"col-featured\">IPLC 专线游戏加速优化</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <th>路由能力</th>\n              <td class=\"no\">—</td>\n              <td class=\"col-featured no\">—</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <th>支持方式</th>\n              <td>标准工单</td>\n              <td class=\"col-featured\">7×24 优先工单支持</td>\n              <td>专属客户经理服务</td>\n            </tr>\n            <tr>\n              <th>适合谁</th>\n              <td>个人日常浏览，设备少、用量稳定</td>\n              <td class=\"col-featured\">设备较多、需要在手机与电脑间切换的人</td>\n              <td>小团队统一配置与统一管理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <p class=\"note\">年付价按 12 个月计入，与月付逐月支付的差异已在上表并列。表格只描述各档之间的相对差别，不构成对任何具体线路表现、解锁范围或响应时长的承诺；实际可用的节点与客户端版本请以你账户内看到的为准。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03</span>\n        <h2>客户端：先确认你手上的是哪一种</h2>\n        <p class=\"sec-sub\">不同系统的名称与设置项并不一致，下面按常见环境说明，不提供未经确认的下载地址。</p>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端：Windows 与 macOS</h3>\n          <p>桌面端是大多数人最先配置的环境。建议先完成一次完整配置并确认可用，再考虑是否把它设为开机启动。</p>\n          <p>若同时装了多个网络工具，先只保留一个在运行，排查会简单很多。</p>\n          <p class=\"meta\">获取方式：请在账户内查看当期提供的客户端与说明，本页不放置外部下载链接。</p>\n          <span class=\"bignum\">01</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>移动端：iOS 与 Android</h3>\n          <p>移动端受系统限制更多，尤其是后台保持连接的部分。使用前建议先确认系统的网络权限已经给出。</p>\n          <p>在同一账户下，移动端常与桌面端共享“同时在线设备”名额，配置前请把这一点算进去。</p>\n          <p class=\"meta\">获取方式：以账户内的官方指引为准，本页不提供跳转链接。</p>\n          <span class=\"bignum\">02</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>路由器与固定环境</h3>\n          <p>把配置放在路由器上，收益是全家设备一次搞定；代价是排查问题时更难定位，因为你看不到单台设备的状态。</p>\n          <p>建议只在前面两步都跑顺之后再尝试，并且保留一条可以随时回退的路径。</p>\n          <p class=\"meta\">适用性取决于路由器型号，本页不列举具体型号清单。</p>\n          <span class=\"bignum\">03</span>\n        </article>\n\n        <article class=\"client\">\n          <h3>临时与备用环境</h3>\n          <p>出差、借用他人电脑这类场景，更适合临时配置而不是长期驻留。用完把配置清理掉，比事后回忆改过哪些地方更稳妥。</p>\n          <p>公共设备上不要保存账户信息，这是常识，但确实是最常被忽略的一条。</p>\n          <p class=\"meta\">本页不提供任何第三方来源的客户端或配置文件。</p>\n          <span class=\"bignum\">04</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04</span>\n        <h2>常见问题，左右各一半</h2>\n        <p class=\"sec-sub\">下面这些问题是按被问到的频率排的，不是按重要程度排的。</p>\n      </div>\n\n      <div class=\"faq\">\n        <article class=\"qa\">\n          <h3>我应该选哪一档？</h3>\n          <p>先看两个数：每月大概多少流量、同时在线几台设备。两项都落在基础版的范围内就选基础版；任一项超出，就往上一档走。设备数量往往比流量更早触到上限。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>年付一定比月付划算吗？</h3>\n          <p>从上表可以看到，三档的年付总额都低于 12 个月月付相加。但划不划算还取决于你是否会连续用满一年。如果只是短期需要，月付更灵活。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>我同时用手机和电脑，算几台设备？</h3>\n          <p>按“同时在线”计算。两台设备在同一时刻都保持连接，就是两台。如果习惯用完就断开，实际占用通常比你以为的少。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>为什么我在客户端里找不到下载按钮？</h3>\n          <p>本页刻意不放任何外部下载地址，因为客户端版本会变化，放在这里容易过期。请在你自己的账户页面内查看当期提供的客户端与对应说明。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>配置好了但打不开网页，先看哪里？</h3>\n          <p>按以下顺序排查：一，是否只有这一台设备有问题；二，设备上是否有其他网络工具同时运行；三，系统的网络权限是否已授予。多数情况在前两步就能定位。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>团队版和旗舰版最大的区别是什么？</h3>\n          <p>主要在三处：设备名额从 5 台扩大到 20 台、流量额度提升到每月 1000GB、以及多了企业定制路由与专属客户经理。如果只是个人使用，旗舰版通常已经够用。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>“全节点原生流媒体解锁”具体指什么？</h3>\n          <p>这是上表中旗舰版与团队版列出的能力项。具体可用的服务范围会随节点变化，本页不做逐项罗列，也不承诺任何特定平台的长期可用性。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>能不能先用基础版再升级？</h3>\n          <p>档位是可以调整的，上表本身就是按档位排列的对照。至于升级方式、差额计算与生效时间，请以账户内实际显示的规则为准，本页不代为说明。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>你们怎么处理我提的问题？</h3>\n          <p>基础版走标准工单，旗舰版为 7×24 优先工单支持，团队版有专属客户经理。提问时把设备系统、客户端版本和出问题的具体步骤写清楚，能显著缩短来回次数。</p>\n        </article>\n\n        <article class=\"qa\">\n          <h3>这一页的信息会更新吗？</h3>\n          <p>会的。价格与权益如有调整，本页的表格会同步修改。如果页面内容与你账户内看到的不一致，以账户内的为准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>花栗鼠</strong>\n    <span>一份写在页面上的使用说明 · 价格与权益以账户内显示为准</span>\n    <a href=\"#how\">回到怎么用</a>\n    <a href=\"#plans\">回到套餐对比</a>\n  </div>\n</footer>",
